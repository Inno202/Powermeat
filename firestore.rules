rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Global reusable helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Role lookups from /staff/{userId}
    function getStaffData() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    function isStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
        getStaffData().active == true;
    }

    function isOwner() {
      return isStaff() && getStaffData().role == 'owner';
    }

    function isManager() {
      return isStaff() && (getStaffData().role == 'owner' || getStaffData().role == 'manager');
    }

    function isCounter() {
      return isStaff() && (getStaffData().role == 'owner' || getStaffData().role == 'manager' || getStaffData().role == 'counter');
    }

    function isDriver() {
      return isStaff() && getStaffData().role == 'driver';
    }

    // 1. PRODUCTS COLLECTION
    match /products/{productId} {
      allow read: if true; // Public catalog browsing
      allow create: if isManager() && isValidId(productId) &&
        incoming().name is string && incoming().name.size() <= 150 &&
        incoming().price is number && incoming().price >= 0;
      allow update: if isManager() && isValidId(productId) &&
        incoming().price is number && incoming().price >= 0;
      allow delete: if isOwner() && isValidId(productId);
    }

    // 2. SPECIALS COLLECTION
    match /specials/{specialId} {
      allow read: if true;
      allow create, update: if isManager() && isValidId(specialId);
      allow delete: if isOwner() && isValidId(specialId);
    }

    // 3. ORDERS COLLECTION
    match /orders/{orderId} {
      // Customers can create guest or authenticated orders
      allow create: if isValidId(orderId) &&
        incoming().customerName is string && incoming().customerName.size() <= 120 &&
        incoming().customerCell is string && incoming().customerCell.size() <= 30 &&
        incoming().total is number && incoming().total >= 0 &&
        incoming().orderStatus == 'new';

      // Reads: Staff can view all orders. Customers can read their own if authenticated.
      allow read: if isStaff() || (isSignedIn() && existing().customerEmail == request.auth.token.email);

      // Updates:
      // - Counter / Manager / Owner can update status, mark paid, weigh & adjust
      // - Assigned Driver can update status to out_for_delivery / completed / cancelled & record cash collected
      allow update: if isStaff() && isValidId(orderId) && (
        isCounter() ||
        (isDriver() && existing().assignedDriverId == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['orderStatus', 'cashCollected', 'driverNotes', 'paymentStatus', 'updatedAt']))
      );

      // Only Owner can delete an order record (e.g. test cleanup)
      allow delete: if isOwner() && isValidId(orderId);
    }

    // 4. STAFF COLLECTION
    match /staff/{userId} {
      allow read: if isSignedIn();
      // Only Owner can create, edit roles or activate/deactivate staff accounts
      allow create, update, delete: if isOwner() && isValidId(userId);
    }

    // 5. ACTIVITY LOGS (Append-only audit trail)
    match /activity_logs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidId(logId) &&
        incoming().userId is string &&
        incoming().action is string &&
        incoming().timestamp is string;
      allow update, delete: if false; // Immutable audit log
    }

    // 6. SITE SETTINGS
    match /settings/{settingId} {
      allow read: if true; // Public store details
      allow write: if isOwner() && isValidId(settingId);
    }

    // 7. DELIVERY AREAS
    match /delivery_areas/{areaId} {
      allow read: if true;
      allow write: if isManager() && isValidId(areaId);
    }
  }
}
