# Copy to .env.local for local work. Never commit a real .env file.
# Nothing secret belongs in a VITE_ variable: everything starting with VITE_ is built
# into the public website. (The Firebase web config in src/services/firebase.ts is
# public by design; the database rules protect the data.)

# Password-free demo with sample data kept in this browser only. Never for the live site.
VITE_DEMO_MODE="false"

# Talk to local Firebase emulators instead of the live project.
VITE_USE_EMULATORS="false"
