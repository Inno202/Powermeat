# Copy to .env.local for local work. Never commit a real .env file.
#
# Nothing secret belongs in a VITE_ variable: everything starting with VITE_ is
# built into the public website and can be read by any visitor.

# Demo staff sign-in (no passwords, data saved in the browser only).
# It is always on while developing (npm run dev). Leave this off for the public site.
VITE_DEMO_MODE="false"
